# Copy to .env.local and fill in from Supabase: Project Settings > API (or "Connect").
# Both values are meant to be public (they ship in the web page); access is enforced
# by the row-level security in supabase/schema.sql. Never put the service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
